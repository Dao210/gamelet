{
  "name": "gamelet",
  "version": "1.0.0",
  "description": "Gamelet is a puzzle arcade for clever, quick mini games including Nerdle and Fibonacci 2584.",
  "keywords": [
    "gamelet",
    "mini games",
    "puzzle games",
    "nerdle",
    "fibonacci 2584",
    "mathle",
    "math game",
    "equation puzzle",
    "daily challenge",
    "mathematical puzzle",
    "number game"
  ],
  "private": true,
  "engines": {
    "node": ">=24.x",
    "npm": ">=10.x"
  },
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "puzzles:check-build": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/puzzles/check-patches-build.mjs",
    "puzzles:verify": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/puzzles/verify-patches.mjs",
    "puzzles:generate": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/puzzles/generate-patches.mjs",
    "i18n:check": "node scripts/check-i18n.mjs",
    "preview": "next build && next start",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:migrate": "drizzle-kit migrate",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@supabase/supabase-js": "^2.106.0",
    "@tanstack/react-virtual": "^3.13.24",
    "@types/fabric": "^5.3.11",
    "@vercel/og": "^0.11.1",
    "cloudinary": "^2.10.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "fabric": "^7.4.0",
    "framer-motion": "^12.39.0",
    "immer": "^11.1.8",
    "next": "^16.2.6",
    "next-intl": "^4.12.0",
    "next-seo": "^7.2.0",
    "p5": "^2.2.3",
    "postgres": "^3.4.9",
    "prisma": "^7.8.0",
    "react": "^19.2.6",
    "react-color": "^2.19.3",
    "react-dom": "^19.2.6",
    "uuid": "^14.0.0",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.9.1",
    "@types/p5": "^1.7.7",
    "@types/react": "19.2.15",
    "@types/react-color": "^3.0.13",
    "@types/react-dom": "^19.2.7",
    "autoprefixer": "^10.5.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.4.0",
    "eslint-config-next": "^16.2.6",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3"
  }
}
