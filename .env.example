# =============================================================================
# Global Prairie Garden - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control

# -----------------------------------------------------------------------------
# Database - Supabase PostgreSQL (Required for /grassland route)
# -----------------------------------------------------------------------------
# How to get this:
# 1. Go to https://supabase.com/dashboard
# 2. Create a new project or select existing project
# 3. Go to Settings > Database
# 4. Copy the "Connection string" (Transaction mode)
# 5. Replace [YOUR-PASSWORD] with your actual database password
#
# Format: postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL="postgresql://postgres:your_password@db.xxxxxxxxxxxxx.supabase.co:5432/postgres"

# -----------------------------------------------------------------------------
# Supabase - Client Keys (Required for Storage & Auth)
# -----------------------------------------------------------------------------
# How to get these:
# 1. Go to https://supabase.com/dashboard
# 2. Select your project
# 3. Go to Settings > API
# 4. Copy "Project URL" and "anon public" key
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your_anon_key_here"

# Service role key (KEEP SECRET - used in server-side API routes only)
SUPABASE_SERVICE_ROLE_KEY="your_service_role_key_here"

# -----------------------------------------------------------------------------
# Cloudinary - Image Storage (Optional - Supabase Storage is preferred)
# -----------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# -----------------------------------------------------------------------------
# NextAuth.js - Authentication
# -----------------------------------------------------------------------------
# NEXTAUTH_URL: Your app's URL (use http://localhost:3000 for development)
# NEXTAUTH_SECRET: Generate with: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your_secret_key_here"

# -----------------------------------------------------------------------------
# Redis - Cache (Optional, for performance optimization)
# -----------------------------------------------------------------------------
REDIS_URL="redis://localhost:6379"

# -----------------------------------------------------------------------------
# Legacy - Prisma (Only for existing /garden route, will be deprecated)
# -----------------------------------------------------------------------------
# DATABASE_URL for Prisma (keep for backward compatibility)
# This is separate from the Supabase DATABASE_URL above
# PRISMA_DATABASE_URL="prisma+postgres://localhost:51213/?api_key=..."
